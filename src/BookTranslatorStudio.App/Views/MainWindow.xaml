<Window x:Class="BookTranslatorStudio.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewModels="clr-namespace:BookTranslatorStudio.ViewModels"
        Title="Book Translator Studio"
        MinWidth="900"
        MinHeight="560"
        WindowState="Maximized">
    <Window.DataContext>
        <viewModels:MainWindowViewModel/>
    </Window.DataContext>

    <Grid Background="#F7F9FC">
        <Grid.RowDefinitions>
            <RowDefinition Height="76"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="46"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="White"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="28,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="24"
                               FontWeight="SemiBold"
                               Text="Book Translator Studio"/>
                    <TextBlock Margin="0,4,0,0"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="Abrir, traducir y continuar"/>
                </StackPanel>

                <Border Grid.Column="1"
                        VerticalAlignment="Center"
                        Background="#EEF4FF"
                        CornerRadius="12"
                        Padding="12,5">
                    <TextBlock Foreground="{StaticResource PrimaryBrush}"
                               FontWeight="SemiBold"
                               Text="v0.4.0"/>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Width="720">
            <Border Background="White"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="42">
                <StackPanel>
                    <TextBlock HorizontalAlignment="Center"
                               FontSize="25"
                               FontWeight="SemiBold"
                               Text="{Binding Project.Name, Mode=OneWay, FallbackValue=Libro no seleccionado}"/>

                    <TextBlock Margin="0,12,0,0"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="16"
                               Text="{Binding TranslationSummary}"/>

                    <ProgressBar Margin="0,34,0,0"
                                 Height="18"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding TranslationProgress, Mode=OneWay}"/>

                    <TextBlock Margin="0,10,0,0"
                               HorizontalAlignment="Center"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Text="{Binding TranslationProgress, Mode=OneWay, StringFormat={}{0:N1}%}"/>

                    <StackPanel Margin="0,38,0,0"
                                HorizontalAlignment="Center"
                                Orientation="Horizontal">
                        <Button Margin="0,0,12,0"
                                Width="150"
                                Padding="18,11"
                                Command="{Binding OpenBookCommand}"
                                Content="Abrir libro"/>

                        <Button Margin="0,0,12,0"
                                Width="180"
                                Padding="18,11"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding StartTranslationCommand}"
                                Content="Traducir / continuar"/>

                        <Button Width="120"
                                Padding="18,11"
                                Command="{Binding PauseTranslationCommand}"
                                Content="Pausar"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid Margin="28,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock VerticalAlignment="Center"
                           Foreground="{StaticResource MutedTextBrush}"
                           Text="{Binding StatusMessage}"/>

                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           Foreground="#B42318"
                           FontWeight="SemiBold">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value=""/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                    <Setter Property="Text" Value="Pausado · progreso conservado"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</Window>
