<Window x:Class="BookTranslatorStudio.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewModels="clr-namespace:BookTranslatorStudio.ViewModels"
        Title="Book Translator Studio"
        Width="1100"
        Height="720"
        MinWidth="900"
        MinHeight="600"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <viewModels:MainWindowViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="72"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="38"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="28,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="22"
                               FontWeight="SemiBold"
                               Text="Book Translator Studio"/>
                    <TextBlock Margin="0,3,0,0"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="Extracción y traducción profesional de libros PDF"/>
                </StackPanel>

                <Border Grid.Column="1"
                        VerticalAlignment="Center"
                        Background="#EEF4FF"
                        CornerRadius="12"
                        Padding="12,5">
                    <TextBlock Foreground="{StaticResource PrimaryBrush}"
                               FontWeight="SemiBold"
                               Text="v0.2.0"/>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="28">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="22">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock FontSize="17"
                               FontWeight="SemiBold"
                               Text="Documento de origen"/>

                    <TextBlock Grid.Row="1"
                               Margin="0,7,0,20"
                               Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap"
                               Text="Carga el libro para contar sus páginas y extraer su texto real."/>

                    <StackPanel Grid.Row="2">
                        <Button Command="{Binding SelectPdfCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Content="Seleccionar PDF"/>
                        <Button Margin="0,10,0,0"
                                Padding="18,9"
                                Command="{Binding ClearSelectionCommand}"
                                Content="Quitar selección"/>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Margin="0,22,0,18">
                        <Separator Margin="0,0,0,18"/>
                        <TextBlock FontWeight="SemiBold" Text="Estado"/>
                        <TextBlock Margin="0,7,0,0"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextWrapping="Wrap"
                                   Text="{Binding StatusMessage}"/>
                        <ProgressBar Margin="0,14,0,0"
                                     Height="5"
                                     IsIndeterminate="True">
                            <ProgressBar.Style>
                                <Style TargetType="ProgressBar">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ProgressBar.Style>
                        </ProgressBar>
                    </StackPanel>

                    <ListBox Grid.Row="4"
                             ItemsSource="{Binding Pages}"
                             SelectedItem="{Binding SelectedPage}"
                             BorderBrush="{StaticResource BorderBrush}"
                             DisplayMemberPath="DisplayName">
                        <ListBox.Style>
                            <Style TargetType="ListBox">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDocumentLoaded}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.Style>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="26">
                <Grid>
                    <Grid x:Name="EmptyState">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDocumentLoaded}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>

                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    MaxWidth="440">
                            <Border Width="76"
                                    Height="76"
                                    Background="#EEF4FF"
                                    CornerRadius="38">
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="29"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           Text="PDF"/>
                            </Border>
                            <TextBlock Margin="0,22,0,0"
                                       HorizontalAlignment="Center"
                                       FontSize="21"
                                       FontWeight="SemiBold"
                                       Text="Ningún libro seleccionado"/>
                            <TextBlock Margin="0,9,0,0"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Text="Selecciona un PDF para extraer su texto página por página."/>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="DocumentState">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDocumentLoaded}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="16"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="18"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <TextBlock Foreground="{StaticResource PrimaryBrush}"
                                       FontWeight="SemiBold"
                                       Text="DOCUMENTO EXTRAÍDO"/>
                            <TextBlock Margin="0,7,0,0"
                                       FontSize="23"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Text="{Binding SelectedDocument.FileName}"/>
                        </StackPanel>

                        <Border Grid.Row="2"
                                Background="#F9FAFB"
                                CornerRadius="8"
                                Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Páginas"/>
                                    <TextBlock FontSize="18"
                                               FontWeight="SemiBold"
                                               Text="{Binding SelectedDocument.PageCount}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Con texto"/>
                                    <TextBlock FontSize="18"
                                               FontWeight="SemiBold"
                                               Text="{Binding SelectedDocument.PagesWithText}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Caracteres"/>
                                    <TextBlock FontSize="18"
                                               FontWeight="SemiBold"
                                               Text="{Binding SelectedDocument.TotalCharacterCount, StringFormat=N0}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="6">
                                    <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Tamaño"/>
                                    <TextBlock FontSize="18"
                                               FontWeight="SemiBold"
                                               Text="{Binding SelectedDocument.FormattedSize}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="4"
                                Background="#F9FAFB"
                                CornerRadius="8"
                                Padding="18">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock FontSize="17"
                                           FontWeight="SemiBold"
                                           Text="{Binding SelectedPage.DisplayName}"/>

                                <TextBox Grid.Row="2"
                                         Text="{Binding SelectedPage.Text}"
                                         IsReadOnly="True"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Disabled"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         FontFamily="Segoe UI"
                                         FontSize="15"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <TextBlock Margin="28,0"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource MutedTextBrush}"
                       Text="Book Translator Studio · .NET 10 · WPF · PdfPig"/>
        </Border>
    </Grid>
</Window>
