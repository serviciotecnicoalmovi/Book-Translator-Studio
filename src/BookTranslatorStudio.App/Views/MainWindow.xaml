<Window x:Class="BookTranslatorStudio.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewModels="clr-namespace:BookTranslatorStudio.ViewModels"
        Title="Book Translator Studio"
        MinWidth="1100"
        MinHeight="680"
        WindowState="Maximized">
    <Window.DataContext>
        <viewModels:MainWindowViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="74"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="White"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="28,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="23"
                               FontWeight="SemiBold"
                               Text="Book Translator Studio"/>
                    <TextBlock Margin="0,3,0,0"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="Preparación integral de libros para traducción"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Margin="0,0,8,0"
                            Padding="14,8"
                            Command="{Binding ImportPdfCommand}"
                            Content="Importar PDF"/>
                    <Button Margin="0,0,8,0"
                            Padding="14,8"
                            Command="{Binding OpenProjectCommand}"
                            Content="Abrir proyecto"/>
                    <Button Margin="0,0,8,0"
                            Padding="14,8"
                            Command="{Binding SaveProjectCommand}"
                            Content="Guardar"/>
                    <Button Padding="14,8"
                            Command="{Binding SaveProjectAsCommand}"
                            Content="Guardar como"/>
                    <Border Margin="16,0,0,0"
                            Background="#EEF4FF"
                            CornerRadius="12"
                            Padding="12,5">
                        <TextBlock Foreground="{StaticResource PrimaryBrush}"
                                   FontWeight="SemiBold"
                                   Text="v0.3.0"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="330"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="White"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="9"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock FontSize="17"
                               FontWeight="SemiBold"
                               Text="Estructura del libro"/>

                    <Border Grid.Row="2"
                            Background="#F9FAFB"
                            CornerRadius="7"
                            Padding="12">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold"
                                       Text="{Binding Project.Name}"/>
                            <TextBlock Margin="0,5,0,0"
                                       Foreground="{StaticResource MutedTextBrush}">
                                <Run Text="{Binding Project.SourcePageCount}"/>
                                <Run Text=" páginas · "/>
                                <Run Text="{Binding Project.WordCount, StringFormat=N0}"/>
                                <Run Text=" palabras"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <ListBox Grid.Row="4"
                             ItemsSource="{Binding Sections}"
                             SelectedItem="{Binding SelectedSection}"
                             DisplayMemberPath="DisplayName"
                             BorderBrush="{StaticResource BorderBrush}"/>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Background="White"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="9"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock FontSize="17"
                               FontWeight="SemiBold"
                               Text="{Binding SelectedSection.Title}"/>

                    <ListBox Grid.Row="2"
                             ItemsSource="{Binding Blocks}"
                             SelectedItem="{Binding SelectedBlock}"
                             DisplayMemberPath="DisplayName"
                             BorderBrush="{StaticResource BorderBrush}"/>
                </Grid>
            </Border>

            <Border Grid.Column="4"
                    Background="White"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="9"
                    Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock FontSize="17"
                               FontWeight="SemiBold"
                               Text="{Binding SelectedBlock.DisplayName}"/>

                    <GroupBox Grid.Row="2" Header="Texto original">
                        <TextBox Margin="8"
                                 Text="{Binding EditableOriginalText, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 BorderThickness="0"/>
                    </GroupBox>

                    <GroupBox Grid.Row="4" Header="Traducción">
                        <TextBox Margin="8"
                                 Text="{Binding EditableTranslatedText, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 BorderThickness="0"/>
                    </GroupBox>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid Margin="28,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock VerticalAlignment="Center"
                           Foreground="{StaticResource MutedTextBrush}"
                           Text="{Binding StatusMessage}"/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <ProgressBar Width="120"
                                 Height="5"
                                 IsIndeterminate="True">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>
                    <TextBlock Margin="16,0,0,0"
                               Foreground="#B42318"
                               FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value=""/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasUnsavedChanges}" Value="True">
                                        <Setter Property="Text" Value="Cambios sin guardar"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
