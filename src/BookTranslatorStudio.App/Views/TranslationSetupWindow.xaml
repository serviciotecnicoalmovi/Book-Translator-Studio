<Window x:Class="BookTranslatorStudio.Views.TranslationSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurar traducción"
        Width="560"
        Height="470"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock FontSize="21"
                   FontWeight="SemiBold"
                   Text="Datos necesarios para traducir"/>

        <StackPanel Grid.Row="2">
            <TextBlock Text="Motor"/>
            <ComboBox x:Name="ProtocolBox"
                      Margin="0,5,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="4">
            <TextBlock Text="URL"/>
            <TextBox x:Name="EndpointBox"
                     Margin="0,5,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="6">
            <TextBlock Text="Modelo"/>
            <TextBox x:Name="ModelBox"
                     Margin="0,5,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="8">
            <TextBlock Text="Clave API, cuando sea necesaria"/>
            <PasswordBox x:Name="ApiKeyBox"
                         Margin="0,5,0,0"/>
        </StackPanel>

        <Grid Grid.Row="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Idioma de origen"/>
                <TextBox x:Name="SourceLanguageBox"
                         Margin="0,5,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Idioma de destino"/>
                <TextBox x:Name="TargetLanguageBox"
                         Margin="0,5,0,0"/>
            </StackPanel>
        </Grid>

        <CheckBox Grid.Row="12"
                  x:Name="RememberKeyBox"
                  Content="Conservar la clave en el proyecto"/>

        <StackPanel Grid.Row="14"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Margin="0,0,10,0"
                    Width="95"
                    IsCancel="True"
                    Content="Cancelar"/>
            <Button Width="110"
                    IsDefault="True"
                    Click="SaveButton_OnClick"
                    Content="Continuar"/>
        </StackPanel>
    </Grid>
</Window>
